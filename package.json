{
  "name": "leadgen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "learn:test": "tsx --env-file=.env scripts/learn-test.ts",
    "index": "tsx --env-file=.env scripts/index-kb.ts",
    "memory:test": "tsx --env-file=.env scripts/memory-test.ts",
    "uplift:test": "tsx --env-file=.env scripts/uplift-test.ts",
    "train:real": "tsx --env-file=.env scripts/train-real.ts",
    "benchmark": "tsx --env-file=.env scripts/benchmark.ts",
    "feature:test": "tsx --env-file=.env scripts/feature-test.ts",
    "fed:test": "tsx --env-file=.env scripts/federated-test.ts",
    "intake:test": "tsx --env-file=.env scripts/intake-test.ts",
    "reminders:test": "tsx --env-file=.env scripts/reminders-test.ts",
    "alerts:test": "tsx --env-file=.env scripts/alerts-test.ts",
    "scoring:test": "tsx --env-file=.env scripts/scoring-test.ts",
    "webchat:test": "tsx --env-file=.env scripts/webchat-test.ts",
    "webhooks:test": "tsx --env-file=.env scripts/webhooks-test.ts",
    "auth:test": "tsx scripts/auth-test.ts",
    "settings:test": "tsx --env-file=.env scripts/settings-test.ts",
    "email:test": "tsx --env-file=.env scripts/email-test.ts",
    "erasure:test": "tsx --env-file=.env scripts/erasure-test.ts",
    "campaigns:test": "tsx --env-file=.env scripts/campaigns-test.ts",
    "imports:test": "tsx scripts/imports-test.ts",
    "twilio:verify": "tsx --env-file=.env scripts/verify-twilio.ts",
    "tunnel": "bash scripts/tunnel.sh",
    "call:me": "tsx --env-file=.env scripts/call-me.ts",
    "twilio:numbers": "tsx --env-file=.env scripts/find-number.ts",
    "twilio:provision": "tsx --env-file=.env scripts/provision-number.ts",
    "twilio:verified": "tsx --env-file=.env scripts/check-verified.ts",
    "voice": "bash scripts/voice-local.sh",
    "voice:check": "tsx --env-file=.env scripts/voice-preflight.ts",
    "finetune:data": "python3 finetune/fetch_sgd.py && tsx --env-file=.env scripts/finetune-export.ts && python3 finetune/build_dataset.py",
    "tts": "bash tts/run.sh",
    "stt": "bash stt/run.sh",
    "stt:fetch": "bash scripts/fetch-parakeet.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.38.3",
    "nanoid": "^5.0.9",
    "next": "15.1.6",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
