# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://leadgen:leadgen@localhost:5433/leadgen
APP_URL=http://localhost:3100

# ─── Claude (required — this is what actually writes the replies) ────────────
# Either set a key here, or run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Model used for customer-facing replies.
# claude-opus-5-5 is the default. For voice, where every 100ms is audible,
# switch to claude-haiku-4-5 and compare: it is materially faster and cheaper.
LEADGEN_MODEL=claude-opus-5-5
LEADGEN_VOICE_MODEL=claude-opus-5-5

# ─── Local models via Ollama (free; used when ANTHROPIC_API_KEY is empty) ────
# On Apple Silicon Ollama runs on the GPU (Metal) automatically.
# `npm run voice` pulls llama3.2:3b and builds the voice model for you.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
# Voice runs the 3B model. Stock llama3.2:3b is the most reliable untuned
# choice (19/21 scenarios as calls). The cache-friendly build speaks far
# sooner but skips tool calls until fine-tuned; after training, point this at
# leadgen-llama3.2-ft:<run> (21/21 in finetune/README.md).
OLLAMA_VOICE_MODEL=llama3.2:3b

# ─── Twilio (voice + SMS) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Meta (Instagram DM / Messenger / WhatsApp) ──────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=leadgen-dev-verify
META_PAGE_ACCESS_TOKEN=

# ─── Email ───────────────────────────────────────────────────────────────────
# Inbound: point your provider's inbound-parse webhook at /api/webhooks/email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
